<Window x:Class="StreamForge.StatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StreamForge" Title="Statistiche · StreamPAL" Width="1000" Height="610" MinWidth="760" MinHeight="480" Background="#F3F6F9" Foreground="#17212B" Icon="Assets/StreamPAL.ico">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><StackPanel><TextBlock x:Name="TitleText" FontSize="23" FontWeight="Bold"/><TextBlock Text="Ascoltatori per stream · ultime 72 ore · aggiornamento in tempo reale" Foreground="#5E7182"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Border Background="White" BorderBrush="#C4D0D8" BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="4"><StackPanel><TextBlock Text="Totale adesso" Foreground="#5E7182"/><TextBlock x:Name="CurrentTotalText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="White" BorderBrush="#C4D0D8" BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="4"><StackPanel><TextBlock Text="Massimo totale 72h" Foreground="#5E7182"/><TextBlock x:Name="MaximumText" FontSize="22" FontWeight="Bold"/></StackPanel></Border></StackPanel></DockPanel>
    <local:StatisticsChart x:Name="Chart" Grid.Row="1" Margin="0,15"/>
    <DockPanel Grid.Row="2"><TextBlock x:Name="LastUpdateText" VerticalAlignment="Center" Foreground="#5E7182"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Esporta Excel" Click="Export_Click"/><Button Content="Chiudi" Click="Close_Click"/></StackPanel></DockPanel>
  </Grid>
</Window>
