<Window x:Class="StreamForge.RegistrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StreamPAL · Registration" Width="620" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6F9" Foreground="#17212B">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="StreamPAL · TRIAL VERSION" FontSize="23" FontWeight="Bold" Foreground="#783EF2" />
    <Border Grid.Row="1" Margin="0,14,0,12" Padding="14" CornerRadius="8" Background="#EAF5FF"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="14" /></Border>
    <StackPanel Grid.Row="2"><TextBlock x:Name="InstallationLabel" Text="Codice installazione" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="Copia" Click="CopyInstallation_Click"/><TextBox x:Name="InstallationCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15"/></DockPanel></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="RegistrationLabel" Text="Codice di registrazione" FontWeight="SemiBold"/><TextBox x:Name="RegistrationCodeBox" AcceptsReturn="True" Height="75" TextWrapping="Wrap" FontFamily="Consolas"/></StackPanel>
    <TextBlock Grid.Row="4" x:Name="StatusText" Margin="3,10" Foreground="#5E7182" TextWrapping="Wrap" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RegisterButton" Content="Registra" Click="Register_Click" Background="#2468F2" Foreground="White"/><Button x:Name="CloseButton" Content="Chiudi" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
