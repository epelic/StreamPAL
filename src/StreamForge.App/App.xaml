<Application x:Class="StreamForge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#16BFF3"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#2468F2"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#783EF2"/>
    <SolidColorBrush x:Key="AccentMagenta" Color="#E42DDF"/>
    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#16D7F3" Offset="0"/><GradientStop Color="#2468F2" Offset="0.45"/><GradientStop Color="#E42DDF" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#17212B"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="9,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#DDF5FC"/><Setter Property="Foreground" Value="#153E78"/></Trigger>
        <Trigger Property="IsSubmenuOpen" Value="True"><Setter Property="Background" Value="#EEE4FD"/><Setter Property="Foreground" Value="#5424A8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8A99A5"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Separator"><Setter Property="Background" Value="#C4D0D8"/><Setter Property="Margin" Value="4,3"/></Style>
  </Application.Resources>
</Application>
