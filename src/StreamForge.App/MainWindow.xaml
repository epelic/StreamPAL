<Window x:Class="StreamForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StreamPAL" Width="1280" Height="790" MinWidth="1050" MinHeight="680" Background="#F3F6F9" Foreground="#17212B">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Menu Background="#F7F9FB" Foreground="#17212B" Margin="-16,-16,-16,10">
      <MenuItem Header="File">
        <MenuItem Header="Carica configurazione…" Click="Import_Click" />
        <MenuItem Header="Salva configurazione" Click="Save_Click" />
        <MenuItem Header="Esporta configurazione…" Click="Export_Click" />
        <Separator />
        <MenuItem Header="Esporta statistiche…" Click="ExportAllStatistics_Click" />
        <Separator />
        <MenuItem x:Name="StartWithWindowsMenu" Header="Avvia con Windows" IsCheckable="True" Click="StartWithWindows_Click" />
        <MenuItem x:Name="StartAllWithWindowsMenu" Header="Avvia tutto con Windows" IsCheckable="True" Click="StartAllWithWindows_Click" />
        <MenuItem Header="Salva setup corrente" Click="Save_Click" />
        <MenuItem Header="Test di stabilità…" Click="StressTest_Click" />
        <Separator />
        <MenuItem Header="Esci" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="Lingua"><MenuItem Header="Italiano" Tag="it" Click="Language_Click"/><MenuItem Header="English" Tag="en" Click="Language_Click"/><MenuItem Header="Español" Tag="es" Click="Language_Click"/><MenuItem Header="Français" Tag="fr" Click="Language_Click"/></MenuItem>
      <MenuItem Header="Info"><MenuItem Header="Informazioni su StreamPAL" Click="Info_Click" /></MenuItem>
    </Menu>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/app-logo.png" Width="48" Height="48" Stretch="Uniform" Margin="0,0,10,0" />
        <StackPanel VerticalAlignment="Center"><TextBlock Text="StreamPAL" FontSize="24" FontWeight="Bold" /><TextBlock Text="Versione 1.0.0" Foreground="#5E7182" /></StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="+ Istanza" Click="AddInstance_Click" />
        <Button Content="Salva" Click="Save_Click" />
        <Button Content="Esporta tutto" Click="Export_Click" />
        <Button Content="Importa" Click="Import_Click" />
        <Button Content="Info" Click="Info_Click" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="9">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ISTANZE (MAX 64)" Margin="7" Foreground="#5E7182" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Duplica" Click="DuplicateInstance_Click" />
            <Button Content="Rimuovi" Click="RemoveInstance_Click" />
          </StackPanel>
          <ListBox x:Name="InstanceList" Background="Transparent" BorderThickness="0" Foreground="#17212B" HorizontalContentAlignment="Stretch" SelectionChanged="InstanceList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#E8EEF3" CornerRadius="5" Margin="2" Padding="8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="#17212B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" HorizontalAlignment="Left" />
                      <TextBlock Text="{Binding SourceType}" FontSize="11" Foreground="#5E7182" TextTrimming="CharacterEllipsis" MaxWidth="165" HorizontalAlignment="Left" />
                      <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Encoders}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Ellipse Width="8" Height="8" Margin="0,3,3,0" Fill="{Binding ConnectionColor}" ToolTip="{Binding Name}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TotalListeners, StringFormat=  👥 {0}}" Foreground="#354B5C" FontSize="11" />
                      </StackPanel>
                      <Button Content="Statistiche" Tag="{Binding}" Click="Statistics_Click" FontSize="10" Padding="5,2" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Grid Grid.Column="1" Height="48" Margin="5,0,0,0">
                      <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ProgressBar Orientation="Vertical" Maximum="100" Value="{Binding LeftLevel}" Foreground="#39DC79" />
                        <ProgressBar Grid.Column="1" Orientation="Vertical" Maximum="100" Value="{Binding RightLevel}" Foreground="#39DC79" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding VuDb}" Foreground="#354B5C" FontSize="8" HorizontalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="9" Padding="15">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition Width="1.4*" />
              <ColumnDefinition Width="115" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Nome istanza" />
              <TextBox x:Name="InstanceNameBox" TextChanged="SharedSource_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Tipo sorgente condivisa" />
              <ComboBox x:Name="SourceTypeBox" SelectionChanged="SourceType_Changed">
                <ComboBoxItem>Test tone</ComboBoxItem>
                <ComboBoxItem>WASAPI</ComboBoxItem>
                <ComboBoxItem>DirectSound</ComboBoxItem>
                <ComboBoxItem>ASIO</ComboBoxItem>
                <ComboBoxItem>File</ComboBoxItem>
                <ComboBoxItem>Streaming URL</ComboBoxItem>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Dispositivo, file o URL" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="↻" Click="RefreshDevices_Click" ToolTip="Aggiorna dispositivi" />
              <ComboBox x:Name="SourceDeviceBox" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Name" SelectionChanged="SourceDevice_Changed" LostKeyboardFocus="SourceDevice_TextCommitted" />
              </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="Ingresso kHz" />
              <ComboBox x:Name="InputRateBox" SelectionChanged="InputRate_Changed"><ComboBoxItem Tag="32000">32.000</ComboBoxItem><ComboBoxItem Tag="44100">44.100</ComboBoxItem><ComboBoxItem Tag="48000">48.000</ComboBoxItem></ComboBox>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="EncoderGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="EncoderGrid_SelectionChanged" Background="#FFFFFF" Foreground="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F4F7FA">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45" />
                <DataGridTextColumn Header="Encoder" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Formato" Binding="{Binding Codec}" Width="90" />
                <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="70" />
                <DataGridTextColumn Header="Destinazione" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="Metadata" Binding="{Binding Metadata}" Width="180" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <Button Content="＋" FontSize="17" Click="AddEncoder_Click" ToolTip="Aggiungi encoder" />
              <Button Content="⧉" FontSize="17" Click="DuplicateEncoder_Click" ToolTip="Duplica encoder" />
              <Button Content="×" FontSize="19" Click="RemoveEncoder_Click" ToolTip="Rimuovi encoder" />
              <Border Height="300" Width="48" Margin="5,10,5,0" Background="#EAF0F3" BorderBrush="#B5C2CC" BorderThickness="1">
                <Grid Margin="7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <ProgressBar x:Name="LeftVu" Orientation="Vertical" Maximum="100" Foreground="#39DC79" />
                  <ProgressBar x:Name="RightVu" Grid.Column="1" Orientation="Vertical" Maximum="100" Foreground="#39DC79" />
                </Grid>
              </Border>
              <TextBlock Text="L  R" HorizontalAlignment="Center" />
              <TextBlock x:Name="VuDbText" Text="−∞ / −∞ dB" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#F7F9FB" CornerRadius="7" Padding="10">
            <Grid x:Name="EncoderEditor">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0" VerticalAlignment="Top">
                <TextBlock Text="Nome encoder" />
                <TextBox x:Name="EncoderNameBox" TextChanged="EncoderField_Changed" />
                <TextBlock Text="Log connessione" Margin="3,5,3,0" />
                <TextBox Text="{Binding ElementName=EncoderGrid, Path=SelectedItem.ConnectionLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="72" Background="#F7FAFC" Foreground="#263746" FontFamily="Consolas" FontSize="10" />
                <TextBlock Text="Canali dalla sorgente" />
                <ComboBox x:Name="ChannelBox" SelectionChanged="EncoderField_Changed">
                  <ComboBoxItem>Stereo</ComboBoxItem>
                  <ComboBoxItem>Solo sinistro</ComboBoxItem>
                  <ComboBoxItem>Solo destro</ComboBoxItem>
                  <ComboBoxItem>Mono (L+R)</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Top">
                <TextBlock Text="Codec" />
                <ComboBox x:Name="CodecBox" SelectionChanged="EncoderField_Changed">
                  <ComboBoxItem>MP3</ComboBoxItem>
                  <ComboBoxItem>AAC-LC</ComboBoxItem>
                  <ComboBoxItem>AAC+ (HE-AAC)</ComboBoxItem>
                  <ComboBoxItem>OGG Vorbis</ComboBoxItem>
                  <ComboBoxItem>Opus</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Uscita codec" />
                <ComboBox x:Name="OutputModeBox" SelectionChanged="EncoderField_Changed">
                  <ComboBoxItem>Stereo</ComboBoxItem>
                  <ComboBoxItem>Mono</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Bitrate / campionamento" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="BitrateBox" Width="80" SelectionChanged="EncoderField_Changed">
                    <ComboBoxItem>16</ComboBoxItem>
                    <ComboBoxItem>24</ComboBoxItem>
                    <ComboBoxItem>32</ComboBoxItem>
                    <ComboBoxItem>48</ComboBoxItem>
                    <ComboBoxItem>64</ComboBoxItem>
                    <ComboBoxItem>96</ComboBoxItem>
                    <ComboBoxItem>128</ComboBoxItem>
                    <ComboBoxItem>192</ComboBoxItem>
                    <ComboBoxItem>256</ComboBoxItem>
                    <ComboBoxItem>320</ComboBoxItem>
                  </ComboBox>
                  <ComboBox x:Name="RateBox" Width="95" SelectionChanged="EncoderField_Changed">
                    <ComboBoxItem>22050</ComboBoxItem>
                    <ComboBoxItem>32000</ComboBoxItem>
                    <ComboBoxItem>44100</ComboBoxItem>
                    <ComboBoxItem>48000</ComboBoxItem>
                    <ComboBoxItem>96000</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Top">
                <TextBlock Text="Server" />
                <ComboBox x:Name="ServerBox" SelectionChanged="EncoderField_Changed">
                  <ComboBoxItem>Icecast 2</ComboBoxItem>
                  <ComboBoxItem>SHOUTcast v1</ComboBoxItem>
                  <ComboBoxItem>SHOUTcast v2</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Host : porta / mount Icecast" />
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="HostBox" Width="120" TextChanged="EncoderField_Changed" />
                  <TextBox x:Name="PortBox" Width="55" TextChanged="EncoderField_Changed" />
                  <TextBox x:Name="MountBox" Width="85" TextChanged="EncoderField_Changed" />
                </StackPanel>
                <TextBlock Text="Password" />
                <PasswordBox x:Name="PasswordBox" ToolTip="Password sorgente" PasswordChanged="Password_Changed" />
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="0,0,4,0" VerticalAlignment="Top">
                <TextBlock Text="Metadata" FontWeight="SemiBold" />
                <TextBlock Text="Titolo corrente" FontSize="10" Foreground="#5E7182" />
                <TextBox x:Name="MetadataBox" TextChanged="EncoderField_Changed" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Nome stazione" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="StationNameBox" TextChanged="EncoderField_Changed" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Descrizione" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="DescriptionBox" TextChanged="EncoderField_Changed" /></StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="URL stazione" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="StationUrlBox" TextChanged="EncoderField_Changed" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Genere" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="GenreBox" TextChanged="EncoderField_Changed" /></StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="AIM" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="AimBox" TextChanged="EncoderField_Changed" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="IRC" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="IrcBox" TextChanged="EncoderField_Changed" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="ICQ" FontSize="10" Foreground="#5E7182" /><TextBox x:Name="IcqBox" TextChanged="EncoderField_Changed" /></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <CheckBox x:Name="EnabledBox" Content="On" VerticalAlignment="Center" Margin="5" Checked="Enabled_Changed" Unchecked="Enabled_Changed" />
                  <Button x:Name="StartButton" Content="Avvia streaming" Click="Start_Click" Background="{StaticResource LogoGradient}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="Footer" Margin="2,10,0,0" Foreground="#5E7182" />
  </Grid>
</Window>
